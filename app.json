{
  "expo": {
    "name": "DogRoutine",
    "slug": "dogroutine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dogroutine",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.anonymous.dogroutine",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "DogRoutine needs access to your photo library so you can choose your dog's profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E1B4B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.dogroutine"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "DogRoutine reads your body mass from Apple Health to estimate calories burned during walks.",
          "NSHealthUpdateUsageDescription": "DogRoutine does not write data to Apple Health.",
          "background": false
        }
      ],
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DogRoutine to access your photos so you can add your dog's profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#208AEF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf9fe",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88,
          "resizeMode": "contain",
          "ios": {
            "backgroundColor": "#faf9fe",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 88
          },
          "android": {
            "backgroundColor": "#faf9fe",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 80
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
