# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
# Regenerated by Expo; do not commit (see file header in repo if present)
expo-env.d.ts

# Metro
.metro-health-check*

# TypeScript / linters
*.tsbuildinfo
.eslintcache

# Env & local secrets (keep .env.example committed)
.env
.env*.local
credentials.json

# Cursor — local MCP config may contain API keys; example template is committed
.cursor/mcp.json

# macOS / Windows
.DS_Store
Thumbs.db
Desktop.ini

# Debug / package manager logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*
*.log

# Native projects — generated by `npx expo prebuild` from app.json + plugins
/ios
/android

# Android / Kotlin
.kotlin/
*.hprof
*.apk
*.aab
*.keystore

# iOS artifacts (if built outside ignored ios/)
*.ipa
*.xcarchive

# Xcode user state (also inside /ios when that folder exists locally)
*.xcuserstate
xcuserdata/

# Signing & keys — never commit
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Test coverage
coverage/

# Project-specific
app-example
